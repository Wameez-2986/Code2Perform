# =============================================================================
# Code2Perform Environment Variables
# =============================================================================

# Server-Side SMTP Email Delivery Configuration
# Used by Next.js server-side endpoint (/api/contact) to dispatch form submissions.
# Credentials are kept strictly on the server and are NEVER exposed to client JS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM="Code2Perform <your_smtp_username>"

# Recipient email address for all contact form submissions
CONTACT_EMAIL=mubeenk710@gmail.com
